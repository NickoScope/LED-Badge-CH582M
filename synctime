#!/bin/bash
# Синхронизация часов бейджа.
# Нужен ЧЕТЫРЁХЗНАЧНЫЙ КОД с экрана: меню -> BT-PAIRING -> KEY1 долго.
# Код новый при каждом входе в режим сопряжения.
#
# Почему именно так:
#   * RTC ставится только по BLE - в legacy_usb_rx() вызова RTC_InitTime нет;
#   * BLE требует авторизации - проверка !authorized в legacy_ble_rx() безусловна;
#   * код появляется только при ВКЛЮЧЁННОЙ защите (SECURITY -> ENABLE);
#   * PIN и данные должны уйти в ОДНОМ соединении - legacy_reset_auth()
#     обнуляет флаг при каждом разрыве.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "$1" ]; then
  echo "как пользоваться: ./synctime <4 цифры с экрана> [текст]"
  echo "  меню -> BT-PAIRING (KEY1 долго) -> прочитать код -> сюда"
  exit 1
fi
PIN="$1"; shift
TEXT="${*:-$(date '+%H:%M')}"
echo "синхронизирую на $(date '+%H:%M:%S'), текст: $TEXT"
"$DIR/badgeble" --pin "$PIN" -m 0 -s 5 -B 100 "$TEXT"
echo
echo "теперь на бейдже: меню -> CLOCK MODE -> TIME (KEY1 долго)"
